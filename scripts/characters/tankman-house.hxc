import funkin.play.character.MultiSparrowCharacter;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;

class TankmanCharacter extends MultiSparrowCharacter
{
  function new()
  {
    super('tankman-house');
  }

  function onNoteHit(event:HitNoteScriptEvent)
  {
    super.onNoteHit(event);

    // Override the hit note animation.
    switch (event.note.kind)
    {
      case "ugh":
        betterAnimHandler('ugh', true);
        return;
      case "hehPrettyGood":
        betterAnimHandler('hehPrettyGood', true);
        return;
      case "augh":
        betterAnimHandler('augh', true);
        return;
    }
  }
  
  function betterAnimHandler(name:String, force:Bool){
    holdTimer = 0;
    this.animation.play(name, force);
    applyAnimationOffsets(name);
  }
}
